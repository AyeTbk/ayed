# Features I think could be useful/necessary:
# - "Scripts" as sequence of commands.
#       Usable in place of commands in keybinds, hooks, etc.
#       Async "scripts"?
# - ...?

# DEV-DEBUG stuff
hooks {

}
mode normal {
    keybinds {
        v  message Current buffer is '$(file)'
    }
}

# Essential for input mapping
hooks {
    input map-input
}


# Essential for general editing
hooks {
    selections-modified $[ selections-merge-overlapping ; look-keep-primary-cursor-in-view ]
    insert-char __auto-indent-shim
}


# Essential for undo/redo
mode normal {
    hooks {
        buffer-modified history-checkpoint
        state-modified:mode history-checkpoint
    }
}


# Essential for diagnostics
hooks {
    selections-modified diagnostics-hover
}

# Essential for completions
completions {
    placement cursor
    source active-buffer
}
hooks {
    buffer-opened completions-source-buffer
    state-modified:mode completions-source-buffer
}
mode insert.* {
    hooks {
        selections-modified completions-check
        completion-sources-modified completions-check

        state-before-modified:mode completions-clear
    }
}
mode normal {
    keybinds {
        # DEBUG
        m $[ message COMPLETIONS ; completions-gather ]
    }
}
@override
panel prompt {
    completions {
        placement prompt
        source commands
    }
}
panel prompt {
    hooks {
        completions-select move --anchored r
    }
}


# Essential for LSP
hooks {
    time-tick lsp-poll
    buffer-opened lsp-doc-sync-open
    buffer-modified lsp-doc-sync-change
    buffer-saved lsp-doc-sync-save
    buffer-closed lsp-doc-sync-close

    buffer-opened lsp-start
    state-modified:format lsp-start
}
mode insert.* {
    hooks {
        selections-modified $[ lsp-completions ; lsp-signature-help ]
    }
}
# DEBUG help for LSP
mode combo-user {
    keybinds {
        l set mode combo-lsp
    }
    keybinds-doc {
        l LSP
    }
}
mode combo-lsp {
    keybinds {
        s lsp-signature-help
        h lsp-hover
    }
    keybinds-doc {
        s Signature help
        h Hover information
    }
}


# Default config

editor {
    indent-size 4
}

mixin basic-movement {
    # FIXME those map-input's are dirty. Allow defining reusable commands in config!
    keybinds {
        <up> move u
        <s-up> move --anchored u
        <c-up> $[ map-input x ; selections-flip --backward ; move u ; map-input x ; selections-flip --backward ]
        <cs-up> $[ map-input x ; selections-flip --backward ; move --anchored u ; map-input x ; selections-flip --backward ]

        <down> move d
        <s-down> move --anchored d
        <c-down> $[ map-input x ; move d ; map-input x ]
        <cs-down> $[ map-input x ; move --anchored d; map-input x ]

        <left> move l
        <s-left> move --anchored l
        <c-left> move-regex --reversed \w+\b|[^\s\w]+
        <cs-left> move-regex --reversed --anchored \w+\b|[^\s\w]+

        <right> move r
        <s-right> move --anchored r
        <c-right> move-regex \w+\b|[^\s\w]+
        <cs-right> move-regex --anchored \w+\b|[^\s\w]+

        <home> move-to-edge --reanchored line-past-indent
        <s-home> move-to-edge --anchored line-past-indent
        <c-home> move-to-edge line-start
        <cs-home> move-to-edge --anchored line-start

        <end> move-to-edge --reanchored line-past-end
        <s-end> move-to-edge --anchored line-past-end
        <c-end> move-to-edge line-end
        <cs-end> move-to-edge --anchored line-end

        <sa-up> look u
        <sa-down> look d
        <sa-left> look l
        <sa-right> look r
    }
}

mixin basic-deletion {
    keybinds {
        <del> delete -c
        <backspace> delete-around --c --p
        <a-backspace> delete-around
    }
}

mixin completions {
    keybinds {
        <a-down> completions-select --next
        <c-n> completions-select --next

        <a-up> completions-select --previous
        <c-p> completions-select --previous
    }
}

# Essential for prompt
@override
panel prompt {
    use basic-movement
    use basic-deletion
    use completions

    keybinds {
        <esc> panel-focus editor
        <c-space> panel-focus editor

        <ret> prompt-exec

        <up> prompt-history --previous
        <down> prompt-history --next

        else insert-char
    }

    prompt-mode search {
        keybinds {
            <ret> prompt-exec move-regex <PROMPT>
        }
    }
    prompt-mode select {
        keybinds {
            <ret> prompt-exec select-regex <PROMPT>
        }
    }
}
hooks {
    panel-focus  set prompt-mode $""
}

# Essential for list-picker
@override
panel list-picker {
    use basic-movement
    use basic-deletion

    keybinds {
        <esc> panel-focus editor
        <c-space> panel-focus editor

        <ret> list-picker-confirm

        <up> list-picker-select --previous
        <down> list-picker-select --next

        else insert-char
    }
}
panel list-picker {
    list-picker-mode file {
        hooks {
            state-modified:panel file-picker-fill-list
            buffer-modified file-picker-filter-list
        }
    }
    list-picker-mode diagnostics {
        hooks {
            state-modified:panel diagnostics-picker-filter-list
            buffer-modified diagnostics-picker-filter-list
        }
    }
}

# Essential for pending commands
mode normal {
    hooks {
        state-modified:pending-command  set mode pending
    }
}
mode pending {
    keybinds {
        <esc>  set mode normal
        else  $(pending-command) $(0)
    }
    hooks {
        state-before-modified:mode  set pending-command $""
        map-input  set mode normal
    }
}

# Essential for warpdrive
@override
panel warpdrive {
    keybinds {
        <esc> panel-focus editor
        else warpdrive-input
    }
}


########################
### Editing keybinds ###

keybinds {
    # Escape hatch for when mode is set to nonsense
    <a-1> $[ set mode normal ; set prompt-mode command ; panel-focus editor ]
}

hooks {
    started set mode normal
}

mode normal {
    use basic-movement
    use completions

    keybinds {
        <del> delete -c
        <a-backspace> delete-around

        k move u
        K move --anchored u
        <c-k> $[ map-input x ; selections-flip --backward ; move u ; map-input x ; selections-flip --backward ]
        <c-K> message <cs-letter> just dont work in terminal :(

        j move d
        J move --anchored d
        <c-j> $[ map-input x ; move d ; map-input x ]

        h move l
        H move --anchored l
        <c-h> move-regex --reversed \w+|[^\s\w]+
        l move r
        L move --anchored r
        <c-l> move-regex \w+|[^\s\w]+

        e move-regex \s*\w+\b|\s*[^\s\w]+
        <s-e> move-regex --anchored \s*\w+\b|\s*[^\s\w]+
        w move-regex \w+\b\s*|[^\s\w]+\s*
        <s-w> move-regex --anchored \w+\b\s*|[^\s\w]+\s*
        b move-regex --reversed \w+\b\s*|[^\s\w]+\s*
        <s-b> move-regex --reversed --anchored \w+\b\s*|[^\s\w]+\s*

        C selections-duplicate --down
        <a-C> selections-duplicate --up
        ; selections-shrink
        <a-;> selections-flip
        , selections-dismiss-extras

        ) selections-rotate
        ( selections-rotate --reversed

        o $[ set mode insert ; selections-flip --forward ; move-to-edge line-past-end ; insert-char \n ]
        <s-o> $[ move u ; set mode insert ; selections-flip --forward ; move-to-edge line-past-end ; insert-char \n ]

        x $[ selections-flip --backward ; move-to-edge --anchored line-start ; selections-flip --forward ; move-to-edge --anchored line-past-end ]

        c $[ set mode insert ; yank ; delete ]

        d $[ yank ; delete ]

        u undo
        U redo

        % $[ move-to-edge buffer-start ; move-to-edge --anchored buffer-end ]

        _ select-regex [^\s][\S\s]*[^\s]|[^\s]

        <lt> indent --less
        <gt> indent --more
        <a-lt> indent --reindent
        <a-gt> indent --auto

        y yank
        p paste
        <s-p> paste --before
        <s-r> $[ set mode insert ; delete ; paste --before ; set mode normal ]

        : panel-focus prompt
        s $[ panel-focus prompt ; set prompt-mode select ]

        / $[ panel-focus prompt ; set prompt-mode search ]
        n $[ panel-focus prompt ; set prompt-mode search ; prompt-exec move-regex <PROMPT> ]

        <backtab> set mode insert
        i set mode insert
        <s-i> $[ move-to-edge line-past-indent ; set mode insert ]

        a set mode insert-append
        <s-a> $[ set mode insert ; move-to-edge line-past-end ]

        <space> set mode combo-user
        g set mode combo-goto
        <c-g> $[ map-input : ; insert-str $"line " ]

        r set pending-command replace
        f set pending-command move-to-char --reanchored
        <s-f> set pending-command move-to-char --anchored
        t set pending-command move-to-char --reanchored --before
        <s-t> set pending-command move-to-char --anchored --before

        q warpdrive
    }
}

mixin mode-insert-append-common {
    use basic-movement
    use basic-deletion
    use completions

    keybinds {
        <c-space> set mode normal
        <esc> set mode normal
        else insert-char
    }
}

mode insert {
    use mode-insert-append-common

    hooks {
        state-modified:mode selections-flip --backward
    }
}

mode insert-append {
    use mode-insert-append-common

    hooks {
        state-modified:mode $[ selections-flip --forward ; move --anchored r ]
        state-before-modified:mode move --anchored l
    }
}


###########################
### View ###

hooks {
    buffer-modified look-keep-primary-cursor-in-view
    resized look-keep-primary-cursor-in-view
}


########################
### Syntax highlight ###

hooks {
    buffer-opened  generate-highlights
    buffer-modified  generate-highlights
}


#############
### Combo ###

mode combo-user {
    keybinds {
        e $[ set list-picker-mode file ; panel-focus list-picker ]
        d $[ set list-picker-mode diagnostics ; panel-focus list-picker ]
        f set mode combo-file
        n message nothing
    }
    keybinds-doc {
        e File picker
        d Diagnostics
        f File management
        n Nothing
    }
}

mode combo-file {
    keybinds {
        s buffer-write
        k buffer-close
    }
    keybinds-doc {
        s Save file
        k Close file
    }
}

mode combo-goto {
    keybinds {
        g move-to-edge buffer-start
        G move-to-edge --anchored buffer-start
        e move-to-edge buffer-end
        E move-to-edge --anchored buffer-end
        k move-to-edge buffer-start
        K move-to-edge --anchored buffer-start
        j move-to-edge buffer-end
        J move-to-edge --anchored buffer-end
        h move-to-edge line-start
        H move-to-edge --anchored line-start
        l move-to-edge line-past-end
        L move-to-edge --anchored line-past-end
        n diagnostics-move-to
        p diagnostics-move-to --previous
        d lsp-goto
    }
    keybinds-doc {
        g,k Buffer start
        G,K Buffer start (anchored)
        e,j Buffer end
        E,J Buffer end (anchored)
        h Line start
        H Line start (anchored)
        l Line end
        L Line end (anchored)
        n Next diagnostic
        p Previous diagnostic
        d Goto definition (LSP)
    }
}
