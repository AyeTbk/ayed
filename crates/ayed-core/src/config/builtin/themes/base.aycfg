theme {
    accent              #393d49
    accent-mild         #2f323c
    accent-dark         #22242a
    accent-bright       #393d49

    box-fg              #696e7c
    box-bg              #22242a

    editor-fg           #dddddd
    editor-bg           #22242a
    editor-nil-line     #586d90
    editor-indent       #2f323b

    cursor              #dfdfdf
    cursor-extra        #b0b0b0
    cursor-eol          #8d95b0
    cursor-extra-eol    #5c677d

    selection           #3b5675
    selection-extra     #313f4e

    linenumbers-fg      #7f7f88
    linenumbers-bg      #22242a
    linenumbers-current #eeeeee
    linenumbers-last    #565665

    warpdrive-fg        #888888
    warpdrive-bg        #22242a
    warpdrive-code      #fa8484

    error               #301010
    error-dark          #180808

    modeline-text       #cccccc
    modeline-text-dim   #8d95b0
}

mode insert.* {
    theme {
        cursor              #d43737
        cursor-extra        #8c2929
        cursor-eol          #b87777
        cursor-extra-eol    #7d5c5c

        selection           #753b3b
        selection-extra     #593636
    }
}


# When unspecified, style's default priority is 10.
syntax-style {
    keyword             #4488cf
    keyword-statement   #aa77cc
    builtin             $[ #62b0fb ; priority:11 ]
    operator            #ddccdd
    delimiter           $[ #ccaa11 ; priority:11 ]
    macro               $[ #3377cc ; priority:11 ]
    type                $[ #55b89b ; priority:12 ]
    literal             $[ #aaddcc ; priority:11 ]
    string              $[ #bb8866 ; priority:14 ]
    lifetime            $[ #cccccc ; priority:14 ]
    function            $[ #b8a4fc ; priority:13 ]
    namespace           #55b89b
    comment             $[ #55887a ; priority:15 ]
}
